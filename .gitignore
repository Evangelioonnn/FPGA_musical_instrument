# Local downloads stay on A's computer; curated reference copies are under references/.
/Notification/
/tmp/
.codex/
.agents/
.DS_Store
Thumbs.db
.vscode/
.idea/
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example
*.lic
*.pem
# Gowin build outputs and per-user GUI state, never the handwritten HDL/IP config.
**/impl/
*.gprj.user
# These legacy-named audit directories contain locally generated projects;
# build_integration.py now creates a fresh project below /tmp for each run.
/project/audio_integration/audit/baseline_50/
/project/audio_integration/audit/packed_50/
# ModelSim libraries and generated simulation products.
**/sim/work*/
**/sim/vwork/
**/sim/smokework/
**/sim/transcript
**/sim/*.log
**/sim/*.wlf
**/sim/*.vcd
**/sim/*.txt
**/sim/*.json
**/sim/*.wav
**/sim/audio/
**/sim/smoke_tb.v
**/sim/voice_smoke_tb.v
# Historical large artifacts / local machine records. Curated evidence has its own directory.
**/audio/*.wav
!/evidence/audio/*.wav
**/reports/
**/validation_manifest.json
**/validation_manifest.sha256
**/file_hashes.json
**/source_hashes.json
*.fs
*.bin
*.binx
*.db
*.pr
# Original working notes are retained locally; published history is curated in docs/history/.
/MEETING_BRIEF_2026-09-18.md

# Current editable board is retained; EDA automatic backups and draft exports stay local.
/BOARD/*_backup/
/BOARD/*.zip
/BOARD/New Project_*.eprj
/BOARD/ProPrj_*.epro

