// Snapshot bundle bridge: 46 little-word-first 64-bit words, N=32/KEYS<=64.
`define AUDIO_STATE_MAGIC 16'h4132
`define AUDIO_TRANSPORT_VERSION 8'd1
`define AUDIO_STATE_WORDS 46
`define AUDIO_STATE_BASE_WORDS 37
`define AUDIO_STATE_EXTENSION_WORDS 4
